@page "/manage"
@model RankBlur.Pages.ManageModel
@{
    ViewData["Title"] = "Control Panel";
}

<header class="top-nav">
    <a class="back-link" asp-page="/Index">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
        BACK TO CHAMPIONSHIP
    </a>
    <span class="nav-label">CONTROL PANEL</span>
</header>

<div class="rank-shell">
    <section class="section">
        <h2 class="section-heading">LOG SESSION</h2>
        <div class="panel">
            @if (!Model.Players.Any())
            {
                <div class="empty-card">
                    <svg class="empty-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14" /><path d="M12 5v14" />
                    </svg>
                    <span class="empty-title">No players registered</span>
                    <span class="empty-subtitle">Add players in the section below first</span>
                </div>
            }
            else
            {
                <form method="post" asp-page-handler="AddSession" class="session-form">
                    <label>
                        Race Date
                        <input asp-for="NewSession.Date" type="date" />
                    </label>

                    <p class="empty-subtitle" style="text-transform:uppercase;letter-spacing:.06rem;margin:.4rem 0 0;">Player Scores (0-100)</p>
                    <div class="score-grid">
                        @for (var i = 0; i < Model.NewSession.Scores.Count; i++)
                        {
                            var player = Model.Players.First(p => p.Id == Model.NewSession.Scores[i].PlayerId);
                            <div class="score-row">
                                <input type="hidden" asp-for="NewSession.Scores[i].PlayerId" />
                                <span class="score-name">@player.Name</span>
                                <input asp-for="NewSession.Scores[i].Points" type="number" min="0" max="100" />
                            </div>
                        }
                    </div>

                    <div class="actions">
                        <button type="submit" class="outline-btn">SALVAR SESSÃO</button>
                    </div>
                </form>
            }
        </div>
    </section>

    <section class="section">
        <h2 class="section-heading">PARTICIPANTES</h2>
        <div class="panel">
            @if (!Model.Players.Any())
            {
                <div class="empty-card nested">
                    <svg class="empty-icon" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                    <span class="empty-title">Nenhum participante</span>
                    <span class="empty-subtitle">Adicione o primeiro piloto abaixo</span>
                </div>
            }
            else
            {
                <ul class="player-list">
                    @foreach (var player in Model.Players)
                    {
                        var stats = Model.Stats.GetValueOrDefault(player.Id);
                        <li class="player-item">
                            <div class="player-summary">
                                <span class="avatar">
                                    @if (!string.IsNullOrEmpty(player.PhotoDataUrl))
                                    {
                                        <img src="@player.PhotoDataUrl" alt="@player.Name" />
                                    }
                                    else
                                    {
                                        <span class="avatar-fallback">@player.Name.Substring(0, 1).ToUpperInvariant()</span>
                                    }
                                </span>
                                <span class="player-name">@player.Name</span>
                                <span class="player-stats">@(stats?.Total ?? 0) pts &middot; @(stats?.Wins ?? 0) wins</span>
                            </div>

                            <details class="player-details">
                                <summary>Ver perfil</summary>
                                @if (!string.IsNullOrEmpty(player.Bio))
                                {
                                    <p class="player-bio">@player.Bio</p>
                                }
                                <form method="post" asp-page-handler="UpdatePlayer" enctype="multipart/form-data" class="player-form inline-form">
                                    <input type="hidden" name="id" value="@player.Id" />
                                    <div class="photo-picker">
                                        <label class="photo-picker-circle @(!string.IsNullOrEmpty(player.PhotoDataUrl) ? "has-image" : "")" for="photo-edit-@player.Id">
                                            <span class="photo-picker-placeholder">Clique para escolher uma foto</span>
                                            <img src="@player.PhotoDataUrl" alt="" />
                                        </label>
                                        <input id="photo-edit-@player.Id" name="photo" type="file" accept="image/*" />
                                        <span class="photo-picker-label">Foto (opcional)</span>
                                    </div>
                                    <div class="field">
                                        <label for="name-edit-@player.Id">Nome do jogador</label>
                                        <input id="name-edit-@player.Id" name="name" value="@player.Name" placeholder="Nome do jogador" />
                                    </div>
                                    <div class="field">
                                        <label for="bio-edit-@player.Id">Informações (opcional)</label>
                                        <textarea id="bio-edit-@player.Id" name="bio" rows="3" placeholder="Apelido, estilo de jogo, etc.">@player.Bio</textarea>
                                    </div>
                                    <div class="actions">
                                        <button type="submit" class="secondary-btn">SALVAR</button>
                                    </div>
                                </form>
                                <form method="post" asp-page-handler="DeletePlayer" onsubmit="return confirm('Isso vai excluir @player.Name permanentemente. Esta ação não pode ser desfeita.');">
                                    <input type="hidden" name="id" value="@player.Id" />
                                    <div class="actions">
                                        <button type="submit" class="danger-btn">EXCLUIR JOGADOR</button>
                                    </div>
                                </form>
                            </details>
                        </li>
                    }
                </ul>
            }

            <details class="add-player-toggle">
                <summary class="outline-btn full-width">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
                    ADICIONAR PARTICIPANTE
                </summary>
                <form method="post" asp-page-handler="AddPlayer" enctype="multipart/form-data" class="player-form">
                    <div class="photo-picker">
                        <label class="photo-picker-circle" for="NewPlayerPhoto">
                            <span class="photo-picker-placeholder">Clique para escolher uma foto</span>
                            <img alt="" />
                        </label>
                        <input asp-for="NewPlayerPhoto" type="file" accept="image/*" />
                        <span class="photo-picker-label">Foto (opcional)</span>
                    </div>
                    <div class="field">
                        <label asp-for="NewPlayerName">Nome do jogador</label>
                        <input asp-for="NewPlayerName" placeholder="Nome do jogador" />
                    </div>
                    <div class="field">
                        <label asp-for="NewPlayerBio">Informações (opcional)</label>
                        <textarea asp-for="NewPlayerBio" rows="3" placeholder="Apelido, estilo de jogo, etc."></textarea>
                    </div>
                    <div class="actions">
                        <button type="submit" class="primary-btn">SALVAR</button>
                    </div>
                </form>
            </details>
        </div>
    </section>
</div>
